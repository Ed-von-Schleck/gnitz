# syntax=docker/dockerfile:1
#
# The gnitz server image. Build it from the repository root (`make image`), and
# run it under `container/seccomp.json`: a runtime's default profile denies the
# io_uring syscalls the server cannot boot without. The documentation's
# Deployment page says how to run it.

ARG RUST_IMAGE=docker.io/library/rust:1-trixie
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot

FROM ${RUST_IMAGE} AS build
WORKDIR /src
COPY crates crates
# The registry and target caches outlive the build, so a rebuild compiles only
# what changed; the binary is copied out of the target cache before it unmounts.
RUN --mount=type=cache,id=gnitz-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=gnitz-cargo-target,target=/src/crates/target \
    cd crates \
 && cargo build --release --locked -p gnitz-server \
 && install -D -m 0755 target/release/gnitz-server /out/gnitz-server \
 && install -d -m 0700 /out/data

FROM ${RUNTIME_IMAGE}
ARG VERSION=unknown
LABEL org.opencontainers.image.title="gnitz-server" \
      org.opencontainers.image.description="GnitzDB: incrementally maintained materialized views over Z-sets" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Ed-von-Schleck/gnitz" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=build /out/gnitz-server /usr/local/bin/gnitz-server
# Owned by distroless's `nonroot`, which the server runs as: a named volume
# mounted here starts with this owner and mode.
COPY --from=build --chown=65532:65532 /out/data /data
COPY LICENSE-APACHE LICENSE-MIT /usr/share/doc/gnitz/
VOLUME /data
ENV GNITZ_LOG_LEVEL=normal
# glibc's malloc asks for transparent huge pages for its heap, so the page
# faults of growing it are fewer. Effective where the host's THP mode is
# `madvise`; no change under `never`.
ENV GLIBC_TUNABLES=glibc.malloc.hugetlb=1
ENTRYPOINT ["/usr/local/bin/gnitz-server"]
CMD ["--workers=auto", "/data", "/data/gnitz.sock"]
